erDiagram
    COUNTRY ||--o{ CITY : contains
    CITY ||--o{ AIRPORT : has
    CITY ||--o{ HOTEL : located_in
    CITY ||--o{ TOUR : runs_in
    COUNTRY ||--o{ TRAVEL_DOCUMENT : issues

    AIRLINE ||--o{ FLIGHT : operates
    AIRPORT ||--o{ FLIGHT : "origin of"
    AIRPORT ||--o{ FLIGHT : "destination of"
    FLIGHT ||--|{ FLIGHT_SEAT : has

    HOTEL ||--|{ ROOM_TYPE : offers

    CUSTOMER ||--o{ TRAVEL_DOCUMENT : holds
    CUSTOMER ||--|| WALLET : owns
    CUSTOMER ||--o{ BOOKING : makes
    AGENT |o--o{ BOOKING : assists

    BOOKING ||--|{ BOOKING_ITEM : contains
    BOOKING_ITEM ||--o| FLIGHT_BOOKING_ITEM : "is a"
    BOOKING_ITEM ||--o| HOTEL_BOOKING_ITEM : "is a"
    BOOKING_ITEM ||--o| TOUR_BOOKING_ITEM : "is a"

    FLIGHT_SEAT ||--o| FLIGHT_BOOKING_ITEM : "sold as"
    TRAVEL_DOCUMENT ||--o{ FLIGHT_BOOKING_ITEM : "used by passenger"
    ROOM_TYPE ||--o{ HOTEL_BOOKING_ITEM : reserved
    TOUR ||--o{ TOUR_BOOKING_ITEM : reserved

    BOOKING ||--o{ PAYMENT : "paid by"
    PAYMENT ||--o{ REFUND : "refunded by"
    AGENT |o--o{ REFUND : processes
    WALLET ||--o{ WALLET_TRANSACTION : records
    BOOKING |o--o{ WALLET_TRANSACTION : "linked to"

    CUSTOMER {
        bigint customer_id PK
        varchar email UK
        varchar first_name
        varchar last_name
        date date_of_birth
    }
    BOOKING {
        bigint booking_id PK
        char booking_ref UK
        bigint customer_id FK
        int agent_id FK
        varchar status
        timestamptz created_at
    }
    BOOKING_ITEM {
        bigint item_id PK
        bigint booking_id FK
        varchar item_type
        numeric amount
    }
    FLIGHT {
        bigint flight_id PK
        char airline_code FK
        char origin_iata FK
        char destination_iata FK
        timestamptz departure_time
        timestamptz arrival_time
        varchar status
    }
    FLIGHT_SEAT {
        bigint seat_id PK
        bigint flight_id FK
        varchar seat_number
        varchar cabin_class
        numeric price
        boolean is_available
        int version
    }
    FLIGHT_BOOKING_ITEM {
        bigint item_id PK,FK
        bigint seat_id FK,UK
        bigint passenger_document_id FK
    }
    HOTEL_BOOKING_ITEM {
        bigint item_id PK,FK
        int room_type_id FK
        date check_in
        date check_out
    }
    TOUR_BOOKING_ITEM {
        bigint item_id PK,FK
        int tour_id FK
        date tour_date
    }
    PAYMENT {
        bigint payment_id PK
        bigint booking_id FK
        numeric amount
        varchar method
        varchar status
    }
    WALLET {
        bigint wallet_id PK
        bigint customer_id FK,UK
        numeric balance
        int version
    }
